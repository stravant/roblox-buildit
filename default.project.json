{
	"name": "BuildIt",
	"servePort": 34873,
	"globIgnorePaths": ["**/*.spec.lua"],
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$ignoreUnknownInstances": true,
			"BuildIt": {
				"$path": "src/shared"
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"$ignoreUnknownInstances": true,
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"$ignoreUnknownInstances": true,
				"BuildTool": {
					"$path": "src/entry/BuildTool.client.lua"
				}
			}
		}
	}
}
