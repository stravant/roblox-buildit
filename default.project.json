{
	"name": "BuildIt",
	"servePort": 34873,
	"globIgnorePaths": ["**/*.spec.lua"],
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$ignoreUnknownInstances": true,
			"BuildIt": {
				"$path": "src/shared"
			},
			"BuildItImporter": {
				"$path": "src/importer"
			}
		},
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"$ignoreUnknownInstances": true,
			"PartLibraryBootstrap": {
				"$path": "src/entry/PartLibraryBootstrap.server.lua"
			},
			"SetStoreServer": {
				"$path": "src/entry/SetStoreServer.server.lua"
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"$ignoreUnknownInstances": true,
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"$ignoreUnknownInstances": true,
				"BuildTool": {
					"$path": "src/entry/BuildTool.client.lua"
				}
			}
		}
	}
}
